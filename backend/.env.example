# Copy to ".env" (ignored by Git) to override defaults. All variables are optional.
# Real data and files must stay outside the Git repository.

# development | production
THERAPY_ENVIRONMENT=development

# Where the database, templates, documents and backups live.
# Default: %PROGRAMDATA%\TherapyOffice on Windows, ~/.local/share/therapy-office elsewhere.
# Must NOT be inside the Git repository.
# THERAPY_DATA_DIR=C:\ProgramData\TherapyOffice

# The application listens on this machine only: 127.0.0.1, localhost or ::1.
# Any other address is refused at startup (no LAN access without a validated TLS setup).
THERAPY_HOST=127.0.0.1
THERAPY_PORT=8000

# Built frontend to serve (optional; leave unset while developing with the Vite dev server)
# THERAPY_FRONTEND_DIST=../frontend/dist

THERAPY_LOG_LEVEL=INFO

# LibreOffice (DOCX -> PDF). Leave unset to search PATH and the standard install folders.
# THERAPY_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# THERAPY_PDF_TIMEOUT_SECONDS=120
